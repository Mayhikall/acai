# =============================================================================
# CORE API — wajib untuk semua mode
# =============================================================================
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000

# PostgreSQL — database harus sudah dibuat sebelum npm run migrate
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=acai

# Generate sesuai docs/ENVIRONMENT.md. Jangan gunakan placeholder di luar contoh.
JWT_SECRET=replace-with-64-hex-characters
INTERNAL_API_SECRET=replace-with-64-hex-characters
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# =============================================================================
# YOUTUBE — pilih api atau mock
# =============================================================================
YOUTUBE_ADAPTER=api

# Wajib hanya jika YOUTUBE_ADAPTER=api
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/youtube/callback

# Wajib hanya jika YOUTUBE_ADAPTER=mock
YOUTUBE_MOCK_FIXTURE=src/db/fixtures/youtube-videos.json

# =============================================================================
# SOLANA DEVNET — alamat publik, bukan secret
# =============================================================================
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_TRANSACTION_VERSION=1
VAULT_PROGRAM_ID=5qjmvHtiiMPS4U9HsodyUhMw297WsRmSpqeesEZgcupy
AUSDC_MINT_ADDRESS=67tawTkJ6Ft2k7SJER8KuP1aQBbgdZMrFyJfUJT7tzZU

# =============================================================================
# FINALIZED CHAIN INDEXER — disarankan untuk sinkronisasi DB dari devnet
# =============================================================================
CHAIN_INDEXER_ENABLED=true
CHAIN_INDEXER_INTERVAL_SECONDS=5
CHAIN_INDEXER_MAX_PAGES=10
CHAIN_INDEXER_BACKFILL_ON_START=false
# Kosongkan untuk memakai src/idl/vault.json
VAULT_IDL_PATH=

# =============================================================================
# ORACLE + BACKGROUND WORKERS — aktifkan setelah keypair oracle siap dan didanai
# =============================================================================
ORACLE_REPORTER=4yyX9nQ7SU7NLDZwPymsAHLyF4MTVugKZktNySuQtY9t
ORACLE_KEYPAIR_PATH=
ORACLE_SUBMIT_ENABLED=false
ORACLE_WORKER_ENABLED=false

WORKERS_ENABLED=false
WORKER_INTERVAL_SECONDS=60
CLAIM_REQUEST_COOLDOWN_SECONDS=15
NOTIFICATION_REMINDER_SECONDS=60
BASELINE_ALERT_SECONDS=300
YOUTUBE_DATA_RETENTION_DAYS=30

ANOMALY_CHECK_ENABLED=false
ANOMALY_MAX_GROWTH_PER_HOUR=100000
ANOMALY_MULTIPLIER=10

# =============================================================================
# TERMS PDF STORAGE — kosong = filesystem lokal; wajib di production
# =============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TERMS_BUCKET=campaign-terms

# =============================================================================
# OPTIONAL DEVNET FAUCET — kosongkan keypair untuk memakai default Solana CLI
# =============================================================================
FAUCET_COMMAND=spl-token
FAUCET_KEYPAIR_PATH=
FAUCET_COOLDOWN_HOURS=24

# =============================================================================
# ONE-TIME CONFIG INITIALIZER — tidak dibutuhkan runtime API
# Config devnet saat ini sudah initialized; simpan hanya bila menjalankan script init
# =============================================================================
PROGRAM_DATA_ADDRESS=CHdAaFZ4z91GoEbtg6UbvDwDnPnsF4DBg8ZdAet1Jqjq
ADMIN_WALLET=6epHJMDaqdoYVwJFU8VfVXFxzrjccESwJcM9FtS7E4Vp
ADMIN_KEYPAIR_PATH=

# =============================================================================
# TEST ONLY
# =============================================================================
E2E_PORT=4010
