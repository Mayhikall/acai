# ==========================================================================
# ACAI FRONTEND ENVIRONMENT VARIABLES (Vercel / Cloud / Staging)
# =========================================================================

# URL endpoint backend API Acai (misal https://api-acai.up.railway.app)
# Default lokal bila dikosongkan: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Opsional: RPC endpoint kustom untuk Solana Devnet (misal Helius, QuickNode, Alchemy)
# Direkomendasikan untuk Demo Day agar terhindar dari limit rate 429 RPC publik Solana.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
